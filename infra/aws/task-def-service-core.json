{
  "family": "chia-florist-service-core",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/chia-florist-task-role",
  "containerDefinitions": [
    {
      "name": "service-core",
      "image": "ACCOUNT_ID.dkr.ecr.ap-southeast-1.amazonaws.com/chia-florist/service-core:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 7129,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "MY_APP_SAYA_HOST",      "value": "0.0.0.0" },
        { "name": "MY_APP_SAYA_PORT",      "value": "7129" },
        { "name": "APP_ENV",               "value": "production" },
        { "name": "POSTGRES_DB_SSLMODE",   "value": "disable" },
        { "name": "SMTP_PORT",             "value": "587" }
      ],
      "secrets": [
        { "name": "JWT_SECRET",                  "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/JWT_SECRET" },
        { "name": "POSTGRES_DB_HOST",            "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/POSTGRES_DB_HOST" },
        { "name": "POSTGRES_DB_NAME",            "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/POSTGRES_DB_NAME" },
        { "name": "POSTGRES_DB_USER",            "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/POSTGRES_DB_USER" },
        { "name": "POSTGRES_DB_PASSWORD",        "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/POSTGRES_DB_PASSWORD" },
        { "name": "SUPABASE_PROJECT_URL",        "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/SUPABASE_PROJECT_URL" },
        { "name": "SUPABASE_SERVICE_ROLE_KEY",   "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/SUPABASE_SERVICE_ROLE_KEY" },
        { "name": "STORAGE_BUCKET",              "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/STORAGE_BUCKET" },
        { "name": "RAJAONGKIR_DESTINATION_URL",  "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/RAJAONGKIR_DESTINATION_URL" },
        { "name": "RAJAONGKIR_CALCULATE_URL",    "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/RAJAONGKIR_CALCULATE_URL" },
        { "name": "RAJAONGKIR_SHIPPING",         "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/RAJAONGKIR_SHIPPING" },
        { "name": "RAJAONGKIR_PAYMENT",          "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/RAJAONGKIR_PAYMENT" },
        { "name": "SMTP_HOST",                   "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/SMTP_HOST" },
        { "name": "SMTP_USERNAME",               "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/SMTP_USERNAME" },
        { "name": "SMTP_PASSWORD",               "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/SMTP_PASSWORD" },
        { "name": "SMTP_FROM",                   "valueFrom": "arn:aws:ssm:ap-southeast-1:ACCOUNT_ID:parameter/chia-florist/SMTP_FROM" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:7129/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/chia-florist/service-core",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}