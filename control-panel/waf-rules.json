[
  {
    "id": "1",
    "description": "HTML breaking injections including whitespace attacks",
    "pattern": "(?:\"[^\"]*[^-]?\u003e)|(?:[^\\w\\s]\\s*\\/\u003e)|(?:\u003e\")",
    "tags": [
      "xss",
      "csrf"
    ],
    "impact": "4",
    "enabled": true
  },
  {
    "id": "2",
    "description": "Attribute breaking injections including whitespace attacks",
    "pattern": "(?:\"+.*[\u003c=]\\s*\"[^\"]+\")|(?:\"\\s*\\w+\\s*=)|(?:\u003e\\w=\\/)|(?:#.+\\)[\\\"\\s]*\u003e)|(?:\"\\s*(?:src|style|on\\w+)\\s*=\\s*\")|(?:[^\\\"]?\\\"[,;\\s]+\\w*[[\\[\\(])",
    "tags": [
      "xss",
      "csrf"
    ],
    "impact": "4",
    "enabled": true
  },
  {
    "id": "3",
    "description": "Unquoted attribute breaking injections",
    "pattern": "(?:^\u003e[\\w\\s]*\u003c\\/?\\w{2,}\u003e)",
    "tags": [
      "xss",
      "csrf"
    ],
    "impact": "2",
    "enabled": true
  },
  {
    "id": "10",
    "description": "Basic directory traversal",
    "pattern": "(?:(?:\\/|\\\\)?\\.+(\\/|\\\\)(?:\\.+)?)|(?:\\w+\\.exe\\??\\s)|(?:;\\s*\\w+\\s*\\/[\\w*-]+\\/)|(?:\\d\\.\\dx\\|)|(?:%(?:c0\\.|af\\.|5c\\.))|(?:\\/(?:%2e){2})",
    "tags": [
      "dt",
      "id",
      "lfi"
    ],
    "impact": "5",
    "enabled": true
  },
  {
    "id": "12",
    "description": "etc/passwd inclusion attempts",
    "pattern": "(?:etc\\/\\W*passwd)",
    "tags": [
      "dt",
      "id",
      "lfi"
    ],
    "impact": "5",
    "enabled": true
  },
  {
    "id": "40",
    "description": "MySQL comments, conditions and ch(a)r injections",
    "pattern": "(?:\\)\\s*when\\s*\\d+\\s*then)|(?:\"\\s*(?:#|--|{))|(?:\\/\\*!\\s?\\d+)|(?:ch(?:a)?r\\s*\\(\\s*\\d)|(?:(?:(n?and|x?or|not)\\s+|\\|\\||\\\u0026\\\u0026)\\s*\\w+\\()",
    "tags": [
      "sqli",
      "id",
      "lfi"
    ],
    "impact": "6",
    "enabled": true
  },
  {
    "id": "42",
    "description": "Classic SQL injection probings 1/2",
    "pattern": "(?:\"\\s*or\\s*\"?\\d)|(?:\\\\x(?:23|27|3d))|(?:^.?\"$)|(?:(?:^[\"\\\\]*(?:[\\d\"]+|[^\"]+\"))+\\s*(?:n?and|x?or|not|\\|\\||\\\u0026\\\u0026)\\s*[\\w\"[+\u0026!@(),.-])|(?:[^\\w\\s]\\w+\\s*[|-]\\s*\"\\s*\\w)|(?:@\\w+\\s+(and|or)\\s*[\"\\d]+)|(?:@[\\w-]+\\s(and|or)\\s*[^\\w\\s])|(?:[^\\w\\s:]\\s*\\d\\W+[^\\w\\s]\\s*\".)|(?:\\Winformation_schema|table_name\\W)",
    "tags": [
      "sqli",
      "id",
      "lfi"
    ],
    "impact": "6",
    "enabled": true
  },
  {
    "id": "1001",
    "description": "SQL Injection Simple (Union/Select)",
    "pattern": "(?i)(union\\s+select|select\\s+.*\\s+from|delete\\s+from|drop\\s+table|update\\s+set)",
    "tags": [
      "sqli"
    ],
    "impact": "5",
    "enabled": true
  },
  {
    "id": "1002",
    "description": "XSS Detection (Script Tag)",
    "pattern": "(?i)(\u003cscript\u003e|javascript:|on\\w+=)",
    "tags": [
      "xss"
    ],
    "impact": "5",
    "enabled": true
  },
  {
    "id": "1003",
    "description": "SQLi Detection (OR Logic / Tautology)",
    "pattern": "(?i)(\\s+OR\\s+['\"\\w]+=['\"\\w]+)",
    "tags": [
      "sqli"
    ],
    "impact": "5",
    "enabled": true
  },
  {
    "id": "1004",
    "description": "Remote Code Execution (RCE) / Command Injection",
    "pattern": "(?i)(;\\s*ls\\s+-\\w+|base64_decode|exec\\s+.*|system\\s*\\(|bin\\/sh|bin\\/bash)",
    "tags": [
      "rce",
      "ci"
    ],
    "impact": "8",
    "enabled": true
  },
  {
    "id": "1005",
    "description": "Malicious User-Agent / Scanner Detection",
    "pattern": "(?i)(sqlmap|nikto|w3af|nmap|acunetix|dirbuster|gobuster)",
    "tags": [
      "scanner",
      "malicious-ua"
    ],
    "impact": "5",
    "enabled": true
  },
  {
    "id": "1006",
    "description": "Log4Shell Vulnerability Exploit (CVE-2021-44228)",
    "pattern": "(?i)(\\$\\{jndi:(ldap|rmi|ldaps|dns):)",
    "tags": [
      "log4j",
      "rce"
    ],
    "impact": "9",
    "enabled": true
  },
  {
    "id": "1007",
    "description": "Shellshock Vulnerability Exploit (CVE-2014-6271)",
    "pattern": "(?i)(\\(\\s*\\)\\s*\\{\\s*:\\s*;\\s*\\}\\s*echo)",
    "tags": [
      "shellshock",
      "rce"
    ],
    "impact": "9",
    "enabled": true
  },
  {
    "id": "1008",
    "description": "Admin Directory / Local Probe Scan",
    "pattern": "(?i)(\\/admin|\\/wp-admin|\\/config|\\/setup|\\/install)",
    "tags": [
      "probe",
      "recon"
    ],
    "impact": "3",
    "enabled": true
  },
  {
    "id": "1009",
    "description": "Local File Inclusion (LFI) & Windows Paths",
    "pattern": "(?i)(?:etc\\/(?:passwd|hosts|shadow|issue|hostname))|(?:boot\\.ini|win\\.ini|system\\.ini)|(?:proc\\/self\\/environ)|(?:Windows[\\\\/]System32)|(?:[a-zA-Z]:[\\\\/](?:windows|winnt|program files|users|etc))",
    "tags": [
      "lfi",
      "dt"
    ],
    "impact": "7",
    "enabled": true
  },
  {
    "id": "1010",
    "description": "SQL Authentication Bypass & Comments",
    "pattern": "(?i)(?:'\\s*(?:--|#|/\\*))|(?:'\\s*;\\s*\\w+)",
    "tags": [
      "sqli"
    ],
    "impact": "6",
    "enabled": true
  },
  {
    "id": "1011",
    "description": "HTML Entity Exploit Obfuscation",
    "pattern": "(?i)(&#(?:x[0-9a-fA-F]+|[0-9]+);)",
    "tags": [
      "sqli",
      "xss",
      "lfi",
      "obfuscation"
    ],
    "impact": "5",
    "enabled": true
  }
]